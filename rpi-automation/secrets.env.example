# Cluster credentials. Copy to secrets.env (gitignored) and fill in the real
# values -- this repository is PUBLIC, so secrets.env must never be committed.
#
#   cp rpi-automation/secrets.env.example rpi-automation/secrets.env
#
# Consumed by rpi-automation/migrate_ips.sh. The same file layout is used by the
# standalone rpi-automation repository.

# Lab WiFi (the NETGEAR router the Pis fall back to)
WIFI_SSID="NETGEAR75"
WIFI_PASSWORD=""

# Pi login -- the stock Raspberry Pi default across the fleet
PI_USER="pi"
PI_PASSWORD=""
